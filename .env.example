# Alpaca paper-trading API keys (free; sign up at https://alpaca.markets/)
# Copy this file to .env and fill in real values. .env is gitignored.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Small-account safety defaults; LIVE remains unsupported even if confirmed.
TRADING_MODE=PAPER
LIVE_TRADING_CONFIRMED=false
STOP_TRADING=false
STOP_TRADING_FILE=results/small_account/STOP_TRADING
